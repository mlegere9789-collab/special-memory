{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perf-machine.schema.json",
  "title": "Performance machines",
  "description": "qc/perf/machine.toml (SPEC-016 section 2). One row per machine used for a run. Integers and text only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": {"const": "perf-machine/1"},
    "machine": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cpu_model", "cpu_cores", "ram_mb", "gpu_model", "vram_mb", "driver", "os_build", "internal_w", "internal_h", "upscaler", "date"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "cpu_model": {"type": "string", "minLength": 1},
          "cpu_cores": {"type": "integer", "minimum": 1},
          "ram_mb": {"type": "integer", "minimum": 1},
          "gpu_model": {"type": "string", "minLength": 1},
          "vram_mb": {"type": "integer", "minimum": 1},
          "driver": {"type": "string", "minLength": 1},
          "os_build": {"type": "string", "minLength": 1},
          "internal_w": {"type": "integer", "minimum": 1},
          "internal_h": {"type": "integer", "minimum": 1},
          "upscaler": {"type": "string", "minLength": 1, "description": "\"off\" when no upscaler runs"},
          "date": {"type": "integer", "minimum": 20200101, "maximum": 99991231, "description": "YYYYMMDD"}
        }
      }
    }
  }
}
