{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather.schema.json",
  "title": "Weather timeline sidecar (SPEC-009 section 3.2)",
  "description": "data/scenarios/<family>/weather.toml. t_min is minutes after 00:00 on 1863-07-01; keys ascend strictly in t_min (enforced by the loader and tools/validators/environment.py, which also limit the wind magnitude to 20000 mm/s).",
  "$defs": {
    "provenance_fields": {
      "properties": {
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "placeholder": {"type": "boolean"},
        "calibration_target": {"type": "string", "pattern": "^CT-[0-9]{3}-[0-9]+$"},
        "sources": {"$ref": "common.schema.json#/$defs/sources"},
        "second_source": {"type": "string"},
        "note": {"type": "string"}
      },
      "required": ["confidence"]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "start_minute", "key"],
  "properties": {
    "schema": {"const": "weather/1"},
    "start_minute": {"type": "integer", "minimum": -10000000, "maximum": 10000000},
    "key": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{"$ref": "#/$defs/provenance_fields"}],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["t_min", "temp_f10", "humidity_pm", "wind_x_mm_s", "wind_y_mm_s", "rain_pm", "clear_vis_mm", "light_pm"],
        "properties": {
          "t_min": {"type": "integer", "minimum": -10000000, "maximum": 10000000},
          "temp_f10": {"type": "integer", "minimum": -1000, "maximum": 1500},
          "humidity_pm": {"type": "integer", "minimum": 0, "maximum": 1000},
          "wind_x_mm_s": {"type": "integer", "minimum": -20000, "maximum": 20000},
          "wind_y_mm_s": {"type": "integer", "minimum": -20000, "maximum": 20000},
          "rain_pm": {"type": "integer", "minimum": 0, "maximum": 1000},
          "clear_vis_mm": {"type": "integer", "minimum": 1, "maximum": 100000000},
          "light_pm": {"type": "integer", "minimum": 0, "maximum": 1000}
        }
      }
    }
  }
}
