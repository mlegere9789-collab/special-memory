{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weapons.schema.json",
  "title": "Weapon table",
  "description": "Rows of data/rules/weapons.toml (SPEC-005 section 1). Integer units only; ticks at 20 per second, trained troops.",
  "$defs": {
    "provenance_fields": {
      "description": "Provenance keys carried flat on a row; the rules in rules-common.schema.json (checked by tools/validate_data.py) decide which combinations are legal.",
      "properties": {
        "confidence": {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        "placeholder": {
          "type": "boolean"
        },
        "calibration_target": {
          "type": "string",
          "pattern": "^CT-[0-9]{3}-[0-9]+$"
        },
        "sources": {
          "$ref": "common.schema.json#/$defs/sources"
        },
        "second_source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    }
  },
  "type": "object",
  "required": [
    "schema",
    "weapon"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "weapons/1"
    },
    "weapon": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/provenance_fields"
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "revolver"
                }
              },
              "required": [
                "class"
              ]
            },
            "then": {
              "properties": {
                "magazine": {
                  "minimum": 2
                },
                "cycle_ticks": {
                  "minimum": 1
                }
              }
            },
            "else": {
              "properties": {
                "magazine": {
                  "const": 1
                }
              }
            }
          }
        ],
        "required": [
          "confidence",
          "id",
          "class",
          "ammo",
          "magazine",
          "cycle_ticks",
          "load_steps",
          "misfire_restart_step",
          "sigma0_urad",
          "sigma_slope_urad_per_100m",
          "aim_scale_pm",
          "powder_mg",
          "misfire_ppm",
          "misfire_fouling_ppm",
          "fouling_per_shot",
          "ram_penalty_pm",
          "fire_drain_ppm",
          "effective_mm",
          "extended_mm",
          "reach_mm"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "class": {
            "enum": [
              "smoothbore",
              "rifled",
              "carbine",
              "revolver",
              "field_gun"
            ]
          },
          "ammo": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "rounds"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "rounds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          },
          "magazine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "cycle_ticks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "load_steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "ticks"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "ticks": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              }
            }
          },
          "misfire_restart_step": {
            "$ref": "#/$defs/id"
          },
          "sigma0_urad": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "sigma_slope_urad_per_100m": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "aim_scale_pm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "powder_mg": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "misfire_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "misfire_fouling_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "fouling_per_shot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "ram_penalty_pm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "fire_drain_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "effective_mm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "extended_mm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "reach_mm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200000000
          }
        },
        "unevaluatedProperties": false
      }
    }
  }
}
