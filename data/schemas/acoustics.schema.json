{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acoustics.schema.json",
  "title": "Acoustics data (SPEC-012 section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "globals",
    "band",
    "source",
    "ground",
    "weather",
    "budget"
  ],
  "properties": {
    "schema": {
      "const": "acoustics/1"
    },
    "globals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "air",
        "propagation",
        "listening"
      ],
      "properties": {
        "air": {
          "$ref": "#/$defs/air"
        },
        "propagation": {
          "$ref": "#/$defs/propagation"
        },
        "listening": {
          "$ref": "#/$defs/listening"
        }
      }
    },
    "band": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/band"
      },
      "maxItems": 3
    },
    "source": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 9
    },
    "ground": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ground"
      }
    },
    "weather": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/weather"
      }
    },
    "budget": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/budget"
      },
      "maxItems": 1
    }
  },
  "$defs": {
    "air": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c0_mm_s",
        "c_per_k_mm_s",
        "confidence"
      ],
      "properties": {
        "c0_mm_s": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 500000
        },
        "c_per_k_mm_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "confidence": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/confidence"
        },
        "placeholder": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/placeholder"
        },
        "calibration_target": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/calibration_target"
        },
        "sources": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/sources"
        },
        "second_source": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/second_source"
        },
        "note": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/note"
        }
      }
    },
    "propagation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shear_ppm",
        "g_min",
        "shadow_sat_g",
        "duct_loss_cdb_per_km",
        "barrier_cap_cdb",
        "profile_step_mm",
        "max_samples",
        "max_range_mm",
        "confidence"
      ],
      "properties": {
        "shear_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "g_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "shadow_sat_g": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "duct_loss_cdb_per_km": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "barrier_cap_cdb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "profile_step_mm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "max_range_mm": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000000000
        },
        "confidence": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/confidence"
        },
        "placeholder": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/placeholder"
        },
        "calibration_target": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/calibration_target"
        },
        "sources": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/sources"
        },
        "second_source": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/second_source"
        },
        "note": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/note"
        }
      }
    },
    "listening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_cell_mm",
        "hyst_cdb",
        "drop_below_cdb",
        "class_faint_cdb",
        "class_clear_cdb",
        "class_loud_cdb",
        "camera_window_ticks",
        "hq_window_ticks",
        "confidence"
      ],
      "properties": {
        "cluster_cell_mm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "hyst_cdb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "drop_below_cdb": {
          "type": "integer",
          "minimum": -20000,
          "maximum": 20000
        },
        "class_faint_cdb": {
          "type": "integer",
          "minimum": -20000,
          "maximum": 20000
        },
        "class_clear_cdb": {
          "type": "integer",
          "minimum": -20000,
          "maximum": 20000
        },
        "class_loud_cdb": {
          "type": "integer",
          "minimum": -20000,
          "maximum": 20000
        },
        "camera_window_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "hq_window_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "confidence": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/confidence"
        },
        "placeholder": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/placeholder"
        },
        "calibration_target": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/calibration_target"
        },
        "sources": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/sources"
        },
        "second_source": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/second_source"
        },
        "note": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/note"
        }
      }
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "f_hz",
        "abs_cdb_per_km",
        "ambient_cdb",
        "foliage_pm",
        "shadow_slope_cdb_per_km",
        "shadow_cap_cdb",
        "confidence"
      ],
      "properties": {
        "f_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "abs_cdb_per_km": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "ambient_cdb": {
          "type": "integer",
          "minimum": -20000,
          "maximum": 20000
        },
        "foliage_pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "shadow_slope_cdb_per_km": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "shadow_cap_cdb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "confidence": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/confidence"
        },
        "placeholder": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/placeholder"
        },
        "calibration_target": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/calibration_target"
        },
        "sources": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/sources"
        },
        "second_source": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/second_source"
        },
        "note": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/note"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "class",
        "level_low_cdb",
        "level_mid_cdb",
        "level_high_cdb",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        },
        "class": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "level_low_cdb": {
          "type": "integer",
          "minimum": -20000,
          "maximum": 20000
        },
        "level_mid_cdb": {
          "type": "integer",
          "minimum": -20000,
          "maximum": 20000
        },
        "level_high_cdb": {
          "type": "integer",
          "minimum": -20000,
          "maximum": 20000
        },
        "priority_cdb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "confidence": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/confidence"
        },
        "placeholder": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/placeholder"
        },
        "calibration_target": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/calibration_target"
        },
        "sources": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/sources"
        },
        "second_source": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/second_source"
        },
        "note": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/note"
        }
      },
      "description": "priority_cdb is optional and 0 when absent"
    },
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "canopy_mm",
        "foliage_cdb_per_100m",
        "confidence"
      ],
      "properties": {
        "class_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "canopy_mm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "foliage_cdb_per_100m": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "confidence": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/confidence"
        },
        "placeholder": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/placeholder"
        },
        "calibration_target": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/calibration_target"
        },
        "sources": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/sources"
        },
        "second_source": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/second_source"
        },
        "note": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/note"
        }
      },
      "description": "class_id ascending and unique: enforced by the Rust loader"
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "temp_dc",
        "wind_x_mm_s",
        "wind_y_mm_s",
        "lapse_mk_per_m",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        },
        "temp_dc": {
          "type": "integer",
          "minimum": -600,
          "maximum": 600
        },
        "wind_x_mm_s": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "wind_y_mm_s": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "lapse_mk_per_m": {
          "type": "integer",
          "minimum": -500,
          "maximum": 500
        },
        "confidence": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/confidence"
        },
        "placeholder": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/placeholder"
        },
        "calibration_target": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/calibration_target"
        },
        "sources": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/sources"
        },
        "second_source": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/second_source"
        },
        "note": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/note"
        }
      },
      "description": "id unique: enforced by the Rust loader"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total",
        "cap_musketry",
        "cap_artillery",
        "cap_burst",
        "cap_voice",
        "confidence"
      ],
      "properties": {
        "max_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cap_musketry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "cap_artillery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "cap_burst": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "cap_voice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "confidence": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/confidence"
        },
        "placeholder": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/placeholder"
        },
        "calibration_target": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/calibration_target"
        },
        "sources": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/sources"
        },
        "second_source": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/second_source"
        },
        "note": {
          "$ref": "rules-common.schema.json#/$defs/provenance/properties/note"
        }
      }
    }
  }
}
